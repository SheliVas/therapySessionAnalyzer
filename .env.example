# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=therapy_analysis

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# External APIs
ASSEMBLYAI_API_KEY=your_assemblyai_key
GEMINI_API_KEY=your_gemini_key
# Optional: LLM_API_KEY if using a different provider
# LLM_API_KEY=

# LLM Configuration
# NOTE: GeminiLLMClient calls the native Gemini REST API and builds the path
# "{LLM_BASE_URL}/v1beta/models/{LLM_MODEL}:generateContent". Keep LLM_BASE_URL
# as the bare host below (do NOT append /v1beta or /openai, or the URL breaks).
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_TIMEOUT=180

# Datadog (Optional)
# DD_API_KEY=your_datadog_api_key
# DD_SITE=datadoghq.com
